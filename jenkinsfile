pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Replace with your actual GitHub repo URL
                git branch: 'main', url: 'https://github.com/Anne7106/agile_assessment-7.git'
            }
        }
        
        stage('Parallel Processing') {
            parallel {
                stage('Academic Performance Checks') {
                    steps {
                        // Runs the performance analytics script
                        bat 'python performance_analytics.py'
                    }
                }
                stage('Student Records Checks') {
                    steps {
                        // Runs the records management script
                        bat 'python student_records.py'
                    }
                }
            }
        }
        
        stage('Summary') {
            steps {
                echo 'Both Academic Performance and Student Records processing are complete.'
            }
        }
    }
}